# Image of the lean scheduler (no Airflow): the pipeline code and its dependencies only.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock /tmp/project/
RUN uv export --project /tmp/project --frozen --no-dev --no-emit-project --no-hashes --extra local \
        -o /tmp/requirements.txt \
    && uv pip install --system --no-cache -r /tmp/requirements.txt \
    && rm -rf /tmp/project /tmp/requirements.txt

RUN useradd --create-home --uid 1000 scheduler
USER scheduler
WORKDIR /app
COPY --chown=scheduler:scheduler src /app/src
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1

CMD ["python", "-m", "energy_pipeline.scheduler"]
